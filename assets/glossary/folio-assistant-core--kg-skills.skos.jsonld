        "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Where to start when a person or an agent reviews a document folio larger than one chapter, such as a DAK or an L1 digital transformation handbook. A pointer, not a method: it names the review skills that already exist, says which question each one answers, and gives the order to read them in. Use when someone asks \"how do I review this\", when a review session starts on a large folio, or before writing a new review skill, so it is not written twice."
        }
      ],
      "skos:notation": "review",
      "dcterms:source": "folio-assistant-core/skills/review/review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns/glossary/kg-skills/review-comments",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "review-comments"
        }
      ],
      "skos:definition": [
        {
          "@value": "Reviewer comments on a folio's edit-set, from a tagged pull-request comment to a structured todo on the review page. Covers the tag a reviewer types, how the comments are ingested into `review-comment/1.0.0` todos, where the published `review-comments.json` comes from and when it refreshes, how a comment follows a renamed block and survives a removed one, who may change a comment's status, and how to change this process. Use when a reviewer asks how to comment on a block, when the review page shows no comments or a wrong one, when editing the ingestion, or when a folio's staging workflow is set up."
        }
      ],
      "skos:notation": "review-comments",
      "dcterms:source": "folio-assistant-core/skills/content/content-lifecycle-ext/review-comments.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns/glossary/kg-skills/review-log-watch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "review-log-watch"
        }
      ],
      "skos:definition": [
        {
          "@value": "Poll a review log (a drafting Contributor Feedback sheet, or a public-comment sheet's Review Change Sets) and its folio repository's issues mechanically, with Tool `review-log-watch`, and start agent work only when a cell people set or an open issue changed. Each issue that no row links yet becomes a Contributor Feedback row, and a closed issue's row is hidden with its text struck through. Use on every wake of a review-log watcher, and when setting up a watcher for a new log."
        }
      ],
      "skos:notation": "review-log-watch",
      "dcterms:source": "folio-assistant-core/skills/content/folio-document-adapter/review-log-watch.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns/glossary/kg-skills/review-sheet-agent-columns",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "review-sheet-agent-columns"
        }
      ],
      "skos:definition": [
        {
          "@value": "Whenever an agent works on a change set of a folio whose review sheet is kept by the Tool `review-sheet-sync`, it writes the Agent tabs' columns for that change set and its comments as it goes: status, step, what it did, the PR, the staging page and its build, what the PR changed and when it finished. Use on every change-set edit, draft, PR, push, merge or close, in a sheet sync or not."
        }
      ],
      "skos:notation": "review-sheet-agent-columns",
      "dcterms:source": "folio-assistant-core/skills/content/folio-document-adapter/review-sheet-agent-columns.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns/glossary/kg-skills/review-sheet-script",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "review-sheet-script"
        }
      ],
      "skos:definition": [
        {
          "@value": "Build, install and reuse the Google Apps Script that keeps a review sheet's links and joined columns current (Tool `review-sheet-sync`). Public-comment mode: comment numbers, sections, pages and lines link into the frozen review draft, and Review Change Sets joins its comments. Drafting mode: one Contributor Feedback tab where each row is a change set with its own GitHub issue, and Sections pick from the document's table of contents. Use when setting up either sheet for a document, when its links are missing or stale, or after a tab, header, anchor or draft link changes."
        }
      ],
      "skos:notation": "review-sheet-script",
      "dcterms:source": "folio-assistant-core/skills/content/folio-document-adapter/review-sheet-script.md",
      "skos:note": "candidate"
    }
  ]
}
