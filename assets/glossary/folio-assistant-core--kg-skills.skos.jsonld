      "skos:prefLabel": [
        {
          "@value": "dsa-checksum"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compute and record the SHA-256 cryptographic digest of a signed Data Sharing Agreement's legal text as a W3C DCAT 3 `spdx:checksum` (`spdx:Checksum` with `spdx:checksumAlgorithm_sha256` and 64-character lowercase hex `spdx:checksumValue`), verified by `check:dsa-hash` (DSA building block B3, process steps P2.2 `Task_Hash` and P2.2a `Task_HashSummary`)."
        }
      ],
      "skos:notation": "dsa-checksum",
      "dcterms:source": "folio-assistant-core/skills/content/folio-document-adapter/dsa-checksum.md",
      "skos:note": "candidate"
    },
