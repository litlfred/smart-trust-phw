      "skos:prefLabel": [
        {
          "@value": "registry-authority-contract"
        }
      ],
      "skos:definition": [
        {
          "@value": "The contract the `external-registry` role is held to when a candidate source is checked against the body that publishes it: resolve the identifier through its own API and return the record, so authority is a resolved fact. When the answer is uncertain or absent the verdict is not invented here; the work plan records the citation as unverified. A role played by an external party is held to a contract, not handed instructions."
        }
      ],
      "skos:notation": "registry-authority-contract",
      "dcterms:source": "folio-assistant-core/skills/content/content-lifecycle-ext/registry-authority-contract.md",
      "skos:note": "candidate"
    },
