          "@value": "block-change-summary"
        }
      ],
      "skos:definition": [
        {
          "@value": "Post-delivery content block change summary for a folio edit-set: extract changed block labels across `.md`, `.ts` and content-type sibling files, present a per-chapter table with `.md`-first GitHub blob links, modified sibling links, local viewer anchors, and change categories. Refines `delivery-summary` for content folios."
        }
      ],
