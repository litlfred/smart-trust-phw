      "dcterms:description": "This profile represents an IPS Immunization record that can be mapped onto a Digital Vaccine Certificates using the WHO PreQual Database",
      "dcterms:type": "Structures: Resource Profiles",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust-phw/StructureDefinition/Immunization-uv-ips-DVC"
      },
      "schema:contentUrl": {
        "@id": "../StructureDefinition-Immunization-uv-ips-DVC.json"
      }
