    {
      "@id": "StructureDefinition-PHWConsent",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/PHWConsent",
      "dcterms:title": "PHW Consent",
      "dcterms:description": "A privacy consent directive held for, and shown to, the holder of a Personal Health Wallet: an IHE PCF 1.1.0 Intermediate Consent whose policy is set by a trust domain. Either explicit (PHWExplicitConsent) or implied (PHWImpliedConsent). Trust-anchor neutral: GDHCN is one possible trust anchor among others.",
      "dcterms:type": "Structures: Resource Profiles",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust-phw/StructureDefinition/PHWConsent"
      },
      "schema:contentUrl": {
        "@id": "../StructureDefinition-PHWConsent.json"
      }
    },
    {
      "@id": "StructureDefinition-PHWDocumentWithConsent",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/PHWDocumentWithConsent",
      "dcterms:title": "IPS document that carries its consent directives",
      "dcterms:description": "An International Patient Summary document a Personal Health Wallet shares or an issuer issues, carrying the consent directives it is shared under, explicit or implied. Carrying them is optional (0..*); when they are carried, the Composition's Advance Directives section (LOINC 42348-3) lists them. The copy in the document is evidence for the receiver; the copy in the sharer's Consent Registry is the one enforced.",
      "dcterms:type": "Structures: Resource Profiles",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust-phw/StructureDefinition/PHWDocumentWithConsent"
      },
      "schema:contentUrl": {
        "@id": "../StructureDefinition-PHWDocumentWithConsent.json"
      }
    },
    {
      "@id": "StructureDefinition-PHWExplicitConsent",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/PHWExplicitConsent",
      "dcterms:title": "PHW Explicit Consent",
      "dcterms:description": "A consent the holder gave by their own act: on the wallet, or on a form a health worker recorded (process L). Categorized with an HL7 ActConsentDirective code (OPTIN, OPTINR, OPTOUT or OPTOUTE). The act is the evidence (source[x]). When the trust domain publishes consent codes, policyRule names the code and the version of its text the holder was shown; otherwise policy.uri names the IHE PCF implicit policy the consent changes.",
      "dcterms:type": "Structures: Resource Profiles",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust-phw/StructureDefinition/PHWExplicitConsent"
      },
      "schema:contentUrl": {
        "@id": "../StructureDefinition-PHWExplicitConsent.json"
      }
    },
    {
      "@id": "StructureDefinition-PHWImpliedConsent",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/PHWImpliedConsent",
      "dcterms:title": "PHW Implied Consent",
      "dcterms:description": "A consent the holder did not give by any act: categorized with an HL7 ActConsentDirective code (IMPLIED, IMPLIEDD or NOPP); the trust domain's default policy applies, normally an IHE PCF implicit policy (Volume 1 §1:53.2.1). Consent.policy names it, and the domain's published policy is the evidence (sourceAttachment). Carried in a document so that a receiver can see which policy the data was shared under.",
      "dcterms:type": "Structures: Resource Profiles",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust-phw/StructureDefinition/PHWImpliedConsent"
      },
      "schema:contentUrl": {
        "@id": "../StructureDefinition-PHWImpliedConsent.json"
      }
    },
