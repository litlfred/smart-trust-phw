#. Source: input/pagecontent/business-processes.md:350
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:350
msgid "J. Issue a Verifiable Digital Health Certificate"
msgstr "J. 签发可验证数字健康证书"

#. Source: input/pagecontent/business-processes.md:362
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:362
msgid "J1. Inform the holder and ask for consent to issue"
msgstr "J1. 告知持有人并征求签发同意"

#. Source: input/pagecontent/business-processes.md:363
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:363
msgid "J2. Collect the data the certificate profile needs"
msgstr "J2. 收集证书配置文件所需的数据"

#. Source: input/pagecontent/business-processes.md:364
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:364
msgid "J2a. Add the consent directives to the certificate (process M, optional)"
msgstr "J2a. 将同意指令添加到证书中（流程 M，可选）"

#. Source: input/pagecontent/business-processes.md:365
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:365
msgid "J3. Issue and sign the certificate"
msgstr "J3. 签发并签名证书"

#. Source: input/pagecontent/business-processes.md:366
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:366
msgid "J4. Issue a consent-backed VHL (process B)"
msgstr "J4. 签发以同意为依据的 VHL（流程 B）"

#. Source: input/pagecontent/business-processes.md:367
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:367
msgid "J5. Generate the QR code"
msgstr "J5. 生成QR 码"

#. Source: input/pagecontent/business-processes.md:368
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:368
msgid "J6. Receive the certificate in the wallet"
msgstr "J6. 在钱包中接收证书"

#. Source: input/pagecontent/business-processes.md:370
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:370
msgid "K. Verify a Certificate and its Status"
msgstr "K. 验证证书及其状态"

#. Source: input/pagecontent/business-processes.md:382
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:382
msgid "K1. Receive the claim"
msgstr "K1. 接收声明"

#. Source: input/pagecontent/business-processes.md:383
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:383
msgid "K2. Present and redeem the VHL (process C)"
msgstr "K2. 出示并兑现 VHL（流程 C）"

#. Source: input/pagecontent/business-processes.md:384
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:384
msgid "K3. Check by hand and decide the claim"
msgstr "K3. 人工核查并判定声明"

#. Source: input/pagecontent/business-processes.md:385
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:385
msgid "K4. Decode the QR code and find the key id"
msgstr "K4. 解码QR 码并查找密钥 id"

#. Source: input/pagecontent/business-processes.md:386
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:386
msgid "K5. Return the issuer's public key [ITI-YY2]"
msgstr "K5. 返回签发方公钥 [ITI-YY2]"

#. Source: input/pagecontent/business-processes.md:387
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:387
msgid "K6. Verify the signature and the claim"
msgstr "K6. 验证签名和声明"

#. Source: input/pagecontent/business-processes.md:388
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:388
msgid "K7. Find the certificate in the registry and return it"
msgstr "K7. 在登记系统中查找证书并返回"

#. Source: input/pagecontent/business-processes.md:389
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:389
msgid "K8. Communicate the result"
msgstr "K8. 告知结果"

#. Source: input/pagecontent/business-processes.md:129
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:129
msgid "Key published under an accepted anchor (DSA P3): DID Core 1.0 + {code0}, or RFC 5280"
msgstr "在接受的锚点下发布的密钥 (DSA P3): DID Core 1.0 + {code0}, 或 RFC 5280"

#. Source: input/pagecontent/business-processes.md:400
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:400
msgid "L. Record Explicit Consent"
msgstr "L. 记录明示同意"

#. Source: input/pagecontent/business-processes.md:412
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:412
msgid "L1. Show the trust domain's consent text (code and version)"
msgstr "L1. 显示信任域的同意文本（代码和版本）"

#. Source: input/pagecontent/business-processes.md:413
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:413
msgid "L2. Read the text and decide"
msgstr "L2. 阅读文本并作出决定"

#. Source: input/pagecontent/business-processes.md:414
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:414
msgid "L3. Record the holder's act as evidence"
msgstr "L3. 将持有人的行为记录为证据"

#. Source: input/pagecontent/business-processes.md:415
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:415
msgid "L4. Post the explicit Consent [ITI-108] Access Consent"
msgstr "L4. 提交明示同意 [ITI-108] 访问同意"

#. Source: input/pagecontent/business-processes.md:416
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:416
msgid "L5. Store the Consent; return Consent.id and versionId [ITI-108]"
msgstr "L5. 存储同意；返回 Consent.id 和 versionId [ITI-108]"

#. Source: input/pagecontent/business-processes.md:417
#. URL: http://smart.who.int/trust-phw/business-processes.html
#: input/pagecontent/business-processes.md:417
msgid "L6. Keep a copy in the wallet"
msgstr "L6. 在钱包中保留一份副本"

